{% extends 'base.html.twig' %}

{% block body %}

    <h1 class="d-flex justify-content-center mt-3 mb-4 text-danger fw-bold">Liste des Posts</h1>

    {% for message in app.flashes('post_success') %}
        <script>
            Swal.fire({
                icon: 'success',
                title: 'Succès',
                text: 'Commentaire ajouté avec succès',
                confirmButtonColor: '#dc3545'
            });
        </script>
    {% endfor %}

    <div class="card shadow-sm p-4 mb-4 border-danger-subtle" style="border-radius: 16px;">
        <table class="table table-striped table-red align-middle text-center">
            <thead>
            <tr>
                <th>Titre Principal</th>
                <th>Photo</th>
                <th>Contenu</th>
                <th>Instagram ID</th>
                <th>Titre Milieu</th>
                <th>2e Contenu</th>
                <th>Voir</th>
                <th>Modifier</th>
                <th>Supprimer</th>
            </tr>
            </thead>
            <tbody>
            {% for post in posts %}
                <tr>
                    <td>{{ post.title }}</td>
                    <td>{{ post.pathPicPost }}</td>
                    <td>{{ post.body|slice(0,100) ~ '...' }}</td>
                    <td>{{ post.LinkSocials }}</td>
                    <td>{{ post.TitleCenter }}</td>
                    <td>{{ post.BodyCenter|slice(0,100) ~ '...' }}</td>
                    <td><a href="{{ path('app_show_post', {'id': post.id}) }}" class="icon-action"><i class="fa-solid fa-eye"></i></a></td>
                    <td><a href="{{ path('admin_edit_post', {'id': post.id}) }}" class="icon-action"><i class="fa-solid fa-edit"></i></a></td>
                    <td><a href="{{ path('admin_delete_post', {'id': post.id}) }}" class="icon-action"><i class="fa-solid fa-trash"></i></a></td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="navigation d-flex justify-content-center mb-4">
        {{ knp_pagination_render(posts) }}
    </div>

    <div class="d-flex justify-content-center">
        <a href="{{ path('admin_add_post') }}" class="btn-add text-decoration-none">Ajouter un Post</a>
    </div>

{% endblock %}
