{% extends 'base.html.twig' %}

{% block title %}Contact{% endblock %}

{% block stylesheets %}
    {{ parent() }}

    <!-- Leaflet CSS -->
    <link
        rel="stylesheet"
        href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
        integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
        crossorigin=""
    />
{% endblock %}

{% block body %}
    <h1 class="text-center mt-3">Besoin de promouvoir un projet ou de valoriser votre image ? Contactez-moi, je serai ravi de vous aider</h1>

    <!-- Messages flash -->
    {% for message in app.flashes('success') %}
        <div style="background:#d4edda; padding:10px; border-radius:5px; margin:20px auto; max-width: 600px;">
            {{ message }}
        </div>
    {% endfor %}

    <div class="contact-container">

        <!-- Formulaire -->
        <div class="contact-form">
            {{ form_start(contact_form) }}
            {{ form_end(contact_form) }}
        </div>

        <!-- Carte Leaflet -->
        <div id="map"></div>

    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}

    <!-- Leaflet JS -->
    <script
        src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
        crossorigin=""
    ></script>

    <!-- Script de la carte -->
    <script src="{{ asset('script/maps.js') }}"></script>
{% endblock %}
