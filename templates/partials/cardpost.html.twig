
<div class="row-cols m-lg-5">
    {% for post in posts %}
        <a class="col-md-2 card-link border-danger-subtle"
           href={{ path('app_show_post', {'id': post.id}) }}>
                <div class="container-img mt-4">
                    <img  src="{{ post.pathPicPost}}"
                          alt="{{ post.title }}">
                </div>

                <h2 class="text-center mt-3 card-link">{{ post.title }}
                </h2>
                <p class="text-center mt-2 pb-2 ">
                    {{ post.body |slice (0,400) ~ "..." }}
                </p>
        </a>
    {% endfor %}
</div>





