{% extends 'base.html.twig' %}

{% block title %} WaveForm {% endblock %}

{% block body %}

<div class="container mt-3">
    {% include 'partials/carousel.html.twig'%}
</div>
    <div class="d-flex">
<div>
    {% include 'partials/cardpost.html.twig' with {
        'posts': lastPost
    } %}
</div>
        <div class="col-md-4 mt-5">
            <h3 class="ms-4">  Toute l'actualité : </h3>
            {% for post in titlePost %}
            <ul>
                <li class="mt-3">
                    <a class="news-link" href="{{ path('app_show_post', {'id': post.id}) }}">
                        {{ post.title }}
                    </a>
                </li>
            </ul>
            {% endfor %}
            <img class="p-5 w-100 mb-5 " src="{{ asset('pics/ChatGPT Image 4 nov. 2025, 11_38_44.png') }}" alt="">
            <img class="p-5 w-100" src="{{ asset('pics/518257557_18279432832272053_8960547773057586588_n.jpg') }}" alt="">
        </div>
    </div>
    <h3 class="mt-2"> Retrouver les Dernieres Sorties Electro :</h3>
    <div>
    {% include 'partials/playlist.html.twig' %}
    </div>
{% endblock %}
